# PORT=5000
# ML_SERVICE_URL=http://localhost:8001
# CLIENT_ORIGIN=http://localhost:3000
# MAX_FILE_SIZE=10485760
# ── Server ────────────────────────────────────────────────────────
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
MAX_FILE_SIZE=10485760

# ── ML Service ────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001

# ── PostgreSQL ────────────────────────────────────────────────────
# Option A: connection string (recommended)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ocula

# Option B: individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ocula
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_in_production
JWT_EXPIRES=7d
